{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${COPILOT_PLUGIN_ROOT}/hooks/session-start.mjs\" copilot"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "view|task|bash|Read|Task|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${COPILOT_PLUGIN_ROOT}/hooks/pre-tool-use.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
