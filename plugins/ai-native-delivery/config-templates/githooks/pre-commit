#!/usr/bin/env node
// ai-native-delivery 引擎 git hook（pre-commit）——由 scripts/init-engine.mjs 安装到 <项目>/.git/hooks/。
// 定位机制：本文件是插件 config-templates/githooks/ 的种子，安装时 @@ENGINE_SCRIPT@@ 被实化为
// check-loop.mjs 的绝对路径（项目侧 .agents/scripts 优先、回退插件内本体——paths.mjs scriptPath
// 同口径）。钩子落 .git/hooks/，不入版本库；卸载 = 删除本文件（init-engine 输出含卸载说明）。
// 车道：LANE = '' 为 check-loop 默认 hard 车道（判低/L3 状态/回归证据/验收勾验/确认指纹/收敛对账）；
// 项目可改 LANE 为 '--hygiene' 或 '--all'（§3.2 L-git 层：git 拦「提交」，一切落盘改动都过这道闸）。
// 不要用 git commit --no-verify 绕过——hard-block 应先修 workflow 文档再提交。
const { spawnSync } = require('node:child_process');
const fs = require('node:fs');

const ENGINE_SCRIPT = "@@ENGINE_SCRIPT@@";
const LANE = "@@LANE@@";

const args = LANE ? [LANE] : [];
const r = spawnSync(process.execPath, [ENGINE_SCRIPT, ...args], { stdio: 'inherit', windowsHide: true });
if (r.error || !fs.existsSync(ENGINE_SCRIPT)) {
  console.error(`pre-commit: 无法启动闭环扫描（${ENGINE_SCRIPT}）——提交已阻止（fail-closed；未安装种子请先跑 node <插件>/scripts/init-engine.mjs）`);
  process.exit(1);
}
process.exit(r.status === null ? 1 : r.status);
