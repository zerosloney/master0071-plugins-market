{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|Terminal|Command|command|Cmd|cmd|Exec|exec|Process|process|Run|run|Pwsh|pwsh|PowerShell|zsh|fish",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pretool-risk.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
