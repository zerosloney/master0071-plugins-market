node_modules/
.env
.env.*
*.log
.plugins-cache.json
plugins/*/.endpoint.json*
# 缓存与配额的原子写用 <file>.<pid>.<hex>.tmp：进程被 kill 时残留的文件名不带裸名，
# 只忽略裸名会让写着「问题文本 + 判定」的半截缓存在 git status 里裸奔——故与 .endpoint.json* 同形加星。
plugins/*/decision-cache.json*
plugins/*/precheck-quota.json*
# 逐插件的临时夹具/调试现场（含嵌套 .git 与写了绝对本地路径的钩子），永不入库
.tmp-review/
# 同类的审计夹具现场（如 .audit-tmp3/：整棵 proj 种子工程），不入库、由作者自行清理
.audit-tmp*/
# 本地调研草稿与审查产物（体量大、非分发内容），不入库；需长期留存的结论请移入 design/
research/
artifacts/review/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
# 自定义规则写在下方（本行提示可删除）
# pstack extras/ 里只有「跑不了的产物」需要挡在工作区索引之外：bun 专属 vendored TS
# （无 bun 时一执行就报错退出）与上游参考脚本（.sh / .awk，Windows 上按文件关联打开）。
# 2026-10-29 修正：此前排的是整个 extras/，把 extras/README.md（讲清楚每个子目录启用条件的那份）
# 与 effort-agents/*.md（宿主支持 extensions 后即可用）也一并挡在索引外——索引看不到说明文档，
# 模型就只看到一堆「被忽略的目录」，反而更容易瞎猜。
plugins/pstack/extras/poteto-mode-scripts/
plugins/pstack/extras/upstream-reference/
